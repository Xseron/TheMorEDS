basicConstraints=CA:FALSE
keyUsage=critical,nonRepudiation
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid,issuer
authorityInfoAccess=OCSP;URI:http://ocsp.mor-test-qtsp.example/ocsp,caIssuers;URI:http://mor-test-qtsp.example/ca/ca1.crt
crlDistributionPoints=URI:http://mor-test-qtsp.example/crl/ca1.crl,URI:http://crl2.mor-test-qtsp.example/crl/ca1.crl
certificatePolicies=@pol1,@pol2
1.3.6.1.5.5.7.1.3=ASN1:SEQUENCE:qcs

[pol1]
policyIdentifier=0.4.0.194112.1.1
CPS.1=http://mor-test-qtsp.example/cps
userNotice.1=@notice1

[notice1]
explicitText="This certificate is a qualified certificate for electronic seals of legal persons issued under the Mor Test QTSP certificate policy. It is provided for testing only."

[pol2]
policyIdentifier=1.3.6.1.4.1.99999.1.2.3
CPS.1=http://mor-test-qtsp.example/cps/seal-policy-v2
userNotice.1=@notice2

[notice2]
explicitText="Second policy notice used to inflate the certificate to a realistic size of about one and a half kilobytes, so that it does not fit into a legacy transaction."

[qcs]
s1=SEQUENCE:qc_compliance
s2=SEQUENCE:qc_type

[qc_compliance]
oid=OID:0.4.0.1862.1.1

[qc_type]
oid=OID:0.4.0.1862.1.6
types=SEQUENCE:qc_type_list

[qc_type_list]
